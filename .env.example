APP_NAME="Information Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ims.example.com
APP_TIMEZONE=Africa/Kampala
SESSION_NAME=IMSSESSID
SESSION_LIFETIME=14400
SESSION_SECURE_COOKIE=true
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ims_database
DB_USERNAME=database_user
DB_PASSWORD=change_this_password

# PowerPoint (.ppt/.pptx) view: headless LibreOffice converts slides to PDF.
# Linux: /usr/bin/soffice; Windows: C:/Program Files/LibreOffice/program/soffice.com
# Leave empty to use soffice on PATH (Linux) or the standard installation (Windows).
LIBREOFFICE_BINARY=
POWERPOINT_PDF_TIMEOUT=60

# UniFi controller (internet portal device approvals)
UNIFI_API_BASE=https://192.168.1.1/proxy/network/integration
UNIFI_API_KEY=
UNIFI_SITE_ID=

# Event check-in QR codes: set to false once all old (unsigned) QR codes have expired
EVENT_CHECKIN_ALLOW_UNSIGNED=true

# Security
# APP_KEY: long random string (php -r "echo 'base64:'.base64_encode(random_bytes(32));").
# Used to derive the key that encrypts secrets stored in the DB (Google OAuth
# tokens/secret, SMTP password, backup service-account JSON, AI API keys).
# Keep it stable and backed up - changing it makes those values unreadable.
APP_KEY=
# Optional dedicated data key (base64:... or 64 hex chars); overrides APP_KEY for encryption.
DATA_ENCRYPTION_KEY=
# Set to false only in an emergency to disable global CSRF enforcement.
CSRF_ENFORCE=true
# Comma-separated script basenames exempt from CSRF enforcement (normally empty).
CSRF_EXEMPT_SCRIPTS=
# Secret for URL-triggered cron (includes/backup-runner.php?key=...); 24+ chars. Prefer CLI cron.
CRON_SECRET=
